# Utente e gruppo del sistema host (modifica se necessario)
# Su Ubuntu/Debian di solito l'utente non-root è 1000 o 1001
PUID=1001
PGID=1001

# Timezone
TZ=Europe/Rome

# Percorsi (relativi al docker-compose.yml)
CONFIG_DIR=./config
DATA_DIR=./data
